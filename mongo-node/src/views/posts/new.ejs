<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Nuevo Post</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
</head>

<body class="grey lighten-4">

    <!-- Navbar -->
    <nav>
        <div class="nav-wrapper teal">
            <a href="/" class="brand-logo center">Social Media</a>
        </div>
    </nav>

    <div class="container" style="margin-top: 40px;">
        <h4 class="center-align teal-text">Crear Nuevo Post</h4>

        <form action="/posts" method="POST" class="card" style="padding: 20px;">
            <div class="input-field">
                <input type="text" name="title" id="title" required minlength="5" maxlength="30">
                <label for="title">Título</label>
            </div>

            <div class="input-field">
                <input type="text" name="content" id="content" required minlength="10">
                <label for="content">Contenido</label>
            </div>

            <div class="input-field">
                <input type="text" name="hashtags" id="hashtags" placeholder="ejemplo: nodejs,web,mongodb">
                <label for="hashtags">Hashtags (separados por comas)</label>
            </div>

            <div class="input-field">
                <input type="text" name="imageUrl" id="imageUrl" placeholder="URL de la imagen">
                <label for="imageUrl">Imagen</label>
            </div>

            <div class="input-field">
                <input type="text" name="userId" id="userId" required>
                <label for="userId">ID del Usuario</label>
            </div>

            <div class="center-align" style="margin-top: 20px;">
                <button type="submit" class="btn waves-effect waves-light teal">
                    Guardar
                </button>
                <a href="/posts" class="btn grey">Cancelar</a>
            </div>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>

</html>