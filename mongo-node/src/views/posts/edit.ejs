<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Editar Post</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
</head>

<body class="container">

    <h3 class="center-align teal-text">Editar Post</h3>

    <form action="/posts/<%= post._id %>?_method=PUT" method="POST">
        <div class="input-field">
            <input type="text" name="title" id="title" value="<%= post.title %>" required minlength="5" maxlength="30">
            <label for="title" class="active">Título</label>
        </div>

        <div class="input-field">
            <textarea name="content" id="content" class="materialize-textarea" required
                minlength="10"><%= post.content %></textarea>
            <label for="content" class="active">Contenido</label>
        </div>

        <div class="input-field">
            <input type="text" name="hashtags" id="hashtags"
                value="<%= post.hashtags ? post.hashtags.join(',') : '' %>">
            <label for="hashtags" class="active">Hashtags (separados por comas)</label>
        </div>

        <div class="input-field">
            <input type="text" name="imageUrl" id="imageUrl" value="<%= post.imageUrl %>">
            <label for="imageUrl" class="active">Imagen</label>
        </div>

        <button type="submit" class="btn waves-effect waves-light teal">Actualizar</button>
        <a href="/posts" class="btn grey">Cancelar</a>
    </form>

</body>

</html>